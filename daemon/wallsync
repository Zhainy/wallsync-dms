VIBE_RANGES = [
    ("red",     0, 20,    0.22, 1.0),
    ("orange",  20, 50,   0.30, 1.0),
    ("yellow",  50, 75,   0.32, 1.0),
    ("green",   75, 150,  0.25, 1.0),
    ("cyan",    150, 195, 0.22, 1.0),
    ("blue",    195, 260, 0.22, 1.0),
    ("purple",  260, 290, 0.25, 1.0),
