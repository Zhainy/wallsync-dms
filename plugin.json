{
  "id": "wallsync",
  "name": "Wallsync",
  "description": "Dual-monitor wallpaper manager with 3D coverflow picker, color-coordinated pairing, and Material You theming",
  "version": "1.0.0",
  "author": "Zhainy",
  "icon": "wallpaper",
  "type": "composite",
  "capabilities": ["daemon", "launcher"],
  "components": {
    "daemon": "./Daemon.qml",
    "launcher": "./Launcher.qml",
    "settings": "./Settings.qml"
  },
  "trigger": "!wp",
  "startupCheck": "./StartupCheck.qml",
  "requires_dms": ">=1.5.0",
  "permissions": ["settings_read", "settings_write"],
  "dependencies": ["awww", "matugen", "magick", "ffmpeg"]
}
